generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nombre    String
  email     String     @unique
  password  String
  rol       String     @default("doctor")
  foto      String?
  createdAt DateTime   @default(now())
  pacientes Paciente[]
  citas     Cita[]
}

model Paciente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String
  email     String?
  foto      String?
  createdAt DateTime @default(now())
  citas     Cita[]
  doctor    Usuario? @relation(fields: [doctorId], references: [id])
  doctorId  Int?
}

model Cita {
  id         Int      @id @default(autoincrement())
  fecha      DateTime
  motivo     String
  estado     String   @default("agendada")
  duracion   Int      @default(30)
  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  doctor     Usuario? @relation(fields: [doctorId], references: [id])
  doctorId   Int?
  createdAt  DateTime @default(now())
}
